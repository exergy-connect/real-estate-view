{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "real-estate-view",
  "build": {
    "command": "node scripts/unpack.js", // Unwraps the master JSON file into individual entity files
    "watch_dir": "docs"                  // Re-run if master JSON changes
  },
  "main": "src/index.ts",
  "compatibility_date": "2026-02-28",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "docs",
    "binding": "ASSETS"
  },
  "vars": {
    "DEPLOYMENT_VERSION": "20260302-1", // Deployment version: YYYYMMDD-revision (update revision for each deployment on same day)
    "GITHUB_REPO": "exergy-connect/real-estate",
    "GITHUB_DATA_BASE_PATH": "har_model/data",
    "GITHUB_BASE_BRANCH": "master" // Base branch for GitHub PRs (main or master)
  },
  "kv_namespaces": [
    {
      "binding": "CACHE_KV",
      "id": "d1612d6a41254c0aa4b11f6fcca85dcf"
    }
  ],
  "compatibility_flags": [
    "nodejs_compat",
    "no_handle_cross_request_promise_resolution"
  ]
}
